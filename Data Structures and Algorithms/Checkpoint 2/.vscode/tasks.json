{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: compilar arquivo atual",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/Zi",
                "/Fo:build\\",
                "/Fd:build\\",
                "/Fe:build\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        }
    ]
}